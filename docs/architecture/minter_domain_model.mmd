classDiagram
  direction LR

  class User

  class Market {
    mint(user, player, shares)
    redeem(user, player, shares)
  }

  class Deposit {
    deposit(user, amount)
  }

  class Ledger {
    post(type, postings)
    balance(account, asset)
  }

  class Account {
    purpose
  }
  class Transaction {
    type
    created_at
  }
  class Posting {
    asset
    amount
  }
  class Mint
  class Redeem

  User --> Market : trades with
  User --> Deposit : calls deposit

  Market --> Ledger : posts to
  Deposit --> Ledger : posts to

  Ledger "1" *-- "*" Transaction : records
  Transaction "1" *-- "2..*" Posting : contains
  Posting --> Account
  Account "*" --> "0..1" User : owned by

  Transaction <|-- Deposit
  Transaction <|-- Mint
  Transaction <|-- Redeem
