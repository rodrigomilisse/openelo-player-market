%% market-service conceptual domain model (target, from docs/Spec.md §3), with implementation status
%% business concepts only: no controllers, repositories or JPA. For the code structure see market_service_packages.mmd
%% colours: green = implemented, blue = partially implemented, red dashed = not implemented, grey = owned by another service
classDiagram
  direction LR

  namespace Trading {
    class Trader {
      username
    }
    class Wallet {
      links a party to its ledger account
    }
    class Trade {
      <<abstract>>
      executedAt
    }
    class Mint {
      shares
      pricePerShare
    }
    class Redeem {
      shares
      pricePerShare
    }
    class MatchedTrade {
      peer-to-peer, buyer and seller
      shares
      price
    }
    class Deposit {
      credits
    }
    class PlayerShare {
      outstandingSupply
    }
    class BondingCurve {
      startPrice (calibrated once)
      mintPrice(supply)
      redeemPrice(supply) = k × mintPrice(supply)
    }
    class Fee {
      rate (curve > matched)
      amount
    }
  }

  namespace Ledger {
    class Account {
      purpose
      allowedNegative
      balance(asset)
    }
    class AccountPurpose {
      <<enumeration>>
      TRADER
      CURVE_RESERVE
      FEE_REVENUE
      DIVIDEND_POOL
    }
    class Transaction {
      immutable
    }
    class Posting {
      <<value object>>
      amount
    }
    class Asset {
      <<abstract>>
    }
    class Credits
  }

  namespace Dividends {
    class DividendPool {
      period
      capacity = fees collected
    }
    class DividendPayout {
      credits
    }
  }

  namespace rating_service {
    class Player
    class EloSnapshot {
      elo
      period
    }
  }

  Trader "0..1" -- "1" Wallet : owns (platform wallets have none)
  Wallet "1" --> "1" Account
  Trader "1" --> "*" Trade : initiates

  Trade <|-- Mint
  Trade <|-- Redeem
  Trade <|-- MatchedTrade
  Trade <|-- Deposit
  Trade <|-- DividendPayout
  Trade "1" --> "1" Transaction : recorded as
  Trade "1" --> "0..1" Fee : charges

  Mint "*" --> "1" PlayerShare
  Redeem "*" --> "1" PlayerShare
  MatchedTrade "*" --> "1" PlayerShare
  PlayerShare "1" *-- "1" BondingCurve : priced by
  PlayerShare "*" --> "1" Player : represents

  Transaction "1" *-- "2..*" Posting
  Posting "*" --> "1" Account
  Posting "*" --> "1" Asset
  Account --> AccountPurpose
  Asset <|-- Credits
  Asset <|-- PlayerShare

  Fee "*" --> "1" DividendPool : funds
  DividendPool "1" --> "*" DividendPayout : pays
  DividendPayout "*" --> "1" EloSnapshot : pegged to
  EloSnapshot "*" --> "1" Player

  note for Transaction "INV postings sum to 0 per asset (not enforced)"
  note for Account "INV balance ≥ 0 unless allowedNegative (not enforced)<br/>INV curve reserve and dividend pool never mix<br/>(today: one shared PLATFORM account)"
  note for BondingCurve "INV the only source of curve prices, no operator discretion<br/>INV mint then redeem always loses a fixed %<br/>(today: hardcoded 100 / 90)"
  note for PlayerShare "INV Mint raises supply, Redeem lowers it<br/>(today: just an Id, no supply)"
  note for DividendPool "INV payouts ≤ fees collected that period<br/>INV pegged to Elo, never to share price"
  style Trader fill:#dcfce7,stroke:#16a34a,color:#14532d
  style Wallet fill:#dcfce7,stroke:#16a34a,color:#14532d
  style Trade fill:#dcfce7,stroke:#16a34a,color:#14532d
  style Posting fill:#dcfce7,stroke:#16a34a,color:#14532d
