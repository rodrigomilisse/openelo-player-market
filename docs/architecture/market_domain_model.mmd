  style Redeem fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
  style Account fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
  style Transaction fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
  style Asset fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
  style Credits fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
